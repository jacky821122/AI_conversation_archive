# Phase B RAG 生成端設定
# 用法：cp .env.example .env，再填入自己的金鑰。.env 已 gitignore。
#
# 生成端有兩種供應商，用 RAG_PROVIDER 切換：
#   openai   （預設）OpenAI 相容端點；設定下方 AGNES_*。
#   anthropic Anthropic Messages 端點，如企業內部 gateway；設定 ANTHROPIC_*。
RAG_PROVIDER=openai

# ── provider=openai（OpenAI 相容端點）──────────────────────────
# 生成端 API 金鑰（只有檢索到的片段會連同問題送往此端點）
AGNES_API_KEY=
# 選填：覆蓋預設。填你的 OpenAI 相容端點 base_url 與模型名。
AGNES_BASE_URL=https://your-openai-compatible-endpoint.example/v1
AGNES_MODEL=your-model-name

# ── provider=anthropic（Anthropic Messages，如企業內部 gateway）──
# 走企業內部 gateway 時把 RAG_PROVIDER 設成 anthropic。金鑰二選一：
#   1) 官方 Anthropic：填 ANTHROPIC_API_KEY（會送成 x-api-key）。
#   2) 企業 gateway：改用 ANTHROPIC_CUSTOM_HEADERS 帶自訂驗證 header，例如
#      "Ocp-Apim-Subscription-Key: <key>"（Claude Code 環境通常已注入）。
# ANTHROPIC_BASE_URL / ANTHROPIC_CUSTOM_HEADERS 若環境已有（例如 Claude Code
# 的 shell）則無需重填，程式會直接沿用。
# 注意：館長的模型用專屬的 RAG_ANTHROPIC_MODEL，「不要」用 ANTHROPIC_MODEL——
# 後者會被 Claude Code shell 注入的同名變數蓋掉，導致此設定失效。
RAG_ANTHROPIC_MODEL=Claude-Sonnet-4.6
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-gateway.example/Anthropic
# ANTHROPIC_CUSTOM_HEADERS=Ocp-Apim-Subscription-Key: <your-subscription-key>

# Phase E：web 問答（/api/ask + /api/model/*）的防護 token。
# 留空 → web 問答停用（端點回 503）。設一組隨機字串才啟用；
# 只擋「燒你生成端 token / 以你名義外呼 / 亂載模型佔 VRAM」，不防資料讀取。
ASK_TOKEN=
# 選填：閒置幾秒後自動卸載模型還 VRAM（預設 900 = 15 分）。
ASK_IDLE_RELEASE_SEC=900
